# ===================================================================
# FarmerProc Backend Environment Configuration Example
# Copy this file to .env and supply environment-specific credentials
# ===================================================================

# Environment mode: development, production, test
ENVIRONMENT=development

# Database URL (PostgreSQL / Aiven Cloud / Supabase / SQLite)
# Example PostgreSQL: postgresql://username:password@hostname:port/dbname?sslmode=require
DATABASE_URL=sqlite:///./farmerproc_test.db

# JWT Security (MANDATORY: Must be a strong, randomly generated string in production)
# In production, if SECRET_KEY is missing or insecure, the backend refuses to start.
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_32charsmin

# JWT Algorithm (default: HS256)
JWT_ALGORITHM=HS256

# JWT Expiration in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OTP Security Policies
OTP_SESSION_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_REQUESTS_PER_HOUR=5

# Explicit CORS Allowed Origins (comma-separated list for custom domains)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000

# ===================================================================
# TELECOM SMS OTP GATEWAYS (Optional - Simulated if not provided)
# ===================================================================
FAST2SMS_API_KEY=
TWO_FACTOR_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=08047104000
TEXTLOCAL_API_KEY=
SMS_GATEWAY_WEBHOOK_URL=
